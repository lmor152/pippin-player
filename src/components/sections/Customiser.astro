    /* ================================================================== */
    /*  tvOS module                                                        */
    /* ================================================================== */
    .tv-root{position:absolute;inset:0;overflow:hidden;font-family:-apple-system,"SF Pro Display","Helvetica Neue",Helvetica,Arial,sans-serif;color:var(--label);background:var(--bg);}
    /* Match TVBackdropLayer(.topRight) in the app: browse art belongs in a
       compact top-right field, not behind the entire shell. Its left and lower
       edges dissolve into the theme's *derived dark surface*, leaving the
       sidebar and shelves on the same tinted background as the real app. */
    /* Colour-bleed wash: over-scaled, heavily-blurred art anchored top-right,
       masked so the artwork's own colours dissolve down and left into the dark
       surface (the accent-tinted --bg) — the hero visibly bleeds into the
       background instead of fading to a flat edge. Slides cross-fade in sync
       with the crisp hero via the shared .cz-slide/.is-on carousel state. */
    .tv-bleed{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none;}
    /* Full-screen ambient wash: the hero art, over-scaled and heavily blurred,
       fills the whole shell so its colours bleed edge-to-edge — the app's
       TVBackdropLayer ambient. The ::after scrim keeps the sidebar/left and the
       shelves/bottom dark enough for text while the art's colour shows through. */
    .tv-bleed-slide{position:absolute;inset:-12%;background-size:cover;background-position:50% 42%;opacity:0;filter:blur(60px) saturate(1.5) brightness(0.92);transition:opacity .6s ease;}
    .tv-bleed-slide.is-on{opacity:.58;}
    .tv-bleed::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg, color-mix(in srgb, var(--bg) 86%, transparent) 0%, color-mix(in srgb, var(--bg) 52%, transparent) 42%, transparent 80%),linear-gradient(0deg, color-mix(in srgb, var(--bg) 85%, transparent) 0%, color-mix(in srgb, var(--bg) 30%, transparent) 40%, transparent 72%);}
    /* Soft-mask the crisp hero so its left/bottom edges dissolve into the
       blurred full-screen bleed behind it — no hard rectangular seam. */
    .tv-hero{position:absolute;top:0;right:0;width:66%;height:72%;z-index:1;overflow:hidden;-webkit-mask-image:radial-gradient(125% 125% at 100% 0%, #000 34%, transparent 84%);mask-image:radial-gradient(125% 125% at 100% 0%, #000 34%, transparent 84%);}
    .tv-hero-slide{position:absolute;inset:0;opacity:0;transition:opacity .6s ease;}
    .tv-hero-slide.is-on{opacity:1;}
    .tv-hero-img{position:absolute;inset:0;background-size:cover;background-position:center;}
    .tv-hero-scrim{position:absolute;inset:0;background:linear-gradient(90deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, color-mix(in srgb, var(--bg) 20%, transparent) 45%, transparent 75%),linear-gradient(0deg, color-mix(in srgb, var(--bg) 78%, transparent) 0%, color-mix(in srgb, var(--bg) 35%, transparent) 42%, transparent 72%);}
    /* The app's ambient layer is derived from the selected theme surface, not
       from the vivid accent token. This deliberately stays dark for blue,
       green, and every custom colour. */
    .tv-ambient{position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(90% 72% at 100% 0%, color-mix(in srgb, var(--bg-secondary) 24%, transparent), transparent 72%);}
    .tv-caption{position:absolute;left:520px;top:196px;right:96px;z-index:2;}
    .tv-title{font-size:76px;line-height:1.0;font-weight:700;letter-spacing:-0.5px;color:var(--label);margin:0;text-shadow:0 2px 24px rgba(0,0,0,0.55);}
    .tv-logo{max-width:640px;max-height:190px;object-fit:contain;object-position:left center;filter:drop-shadow(0 3px 20px rgba(0,0,0,0.55));display:block;}
    .tv-meta{display:flex;align-items:center;gap:14px;margin-top:26px;font-size:29px;font-weight:500;color:var(--label);text-shadow:0 1px 12px rgba(0,0,0,0.55);}
    .tv-meta .tv-dot{width:5px;height:5px;border-radius:50%;background:var(--label-tertiary);}
