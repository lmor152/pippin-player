---
/**
 * Features — id="features". One cohesive section: a single, uniform grid of
 * feature tiles (the MPV player capabilities and every-else customisation touch
 * merged together), closed by an auto-scrolling codec/format "wall".
 */

// Every Pippin feature as one uniform tile. Leads with the MPV player
// capabilities, then widens into customisation and everything else.
const features = [
  { icon: 'film',      title: 'MPV-based player',          desc: 'Play almost any format, hardware-accelerated, on a rock-solid MPV core.' },
  { icon: 'hdr',       title: 'HDR done right',            desc: 'HDR10, HDR10+, Dolby Vision and HLG, tone-mapped exactly as intended.' },
  { icon: 'audio',     title: 'Lossless audio',            desc: 'Dolby Atmos, DD+, DTS-HD and TrueHD, bitstreamed untouched to your receiver.' },
  { icon: 'subtitles', title: 'Subtitles that look right', desc: 'PGS/VOBSUB image subs, SRT and full ASS / SSA styling, rendered crisply.' },
  { icon: 'subsfetch', title: 'Subtitles on demand',       desc: 'Missing subs? Search OpenSubtitles and SubDL without leaving playback.' },
  { icon: 'previews',  title: 'Generated scrub previews',  desc: 'On-device scrub thumbnails from a headless MPV engine — no Trickplay or BIF needed.' },
  { icon: 'precision', title: 'Precision playback',        desc: 'Frame-accurate seeking, thumbnail scrubbing, variable speed and per-title tracks.' },
  { icon: 'resume',    title: 'Never lose your place',     desc: 'Continue Watching, Up Next and skip intro / credits from chapter markers.' },
  { icon: 'offline',   title: 'Watch offline',             desc: 'Download any title — and its metadata — for the plane or the train.' },
  { icon: 'layout',    title: 'Custom pages & shelves',    desc: 'Build your home from scratch — add, reorder and rename shelves and whole pages.' },
  { icon: 'shelves',   title: 'Shelf styles',              desc: 'Show any shelf as a Row, a Spotlight carousel, or a full-bleed Hero.' },
  { icon: 'palette',   title: 'Accent & themes',           desc: 'Re-tint the whole app with any accent. Light, Dark and True Black for OLED.' },
  { icon: 'poster',    title: 'Poster sizes',              desc: 'From compact grids to big cinematic artwork — tuned per shelf.' },
  { icon: 'music',     title: 'Theme songs',               desc: "Hear a show's theme as you browse it, on both Plex and Jellyfin." },
  { icon: 'servers',   title: 'Multiple servers',          desc: 'Combine Plex and Jellyfin servers with per-network profiles.' },
  { icon: 'ratings',   title: 'Rich metadata',             desc: 'IMDb, TMDb, Trakt, Rotten Tomatoes, Metacritic and Letterboxd ratings.' },
  { icon: 'spoilers',  title: 'Hide spoilers',             desc: 'Blur episode thumbnails, titles and summaries for anything you haven’t watched yet.' },
  { icon: 'search',    title: 'Search everywhere',         desc: 'Find anything across every connected server, instantly.' },
];

// Format wall chips — hammered home twice for a seamless CSS marquee loop.
const formatChips = [
  'HEVC', 'H.264', 'AV1', 'VP9', 'MPEG-2', 'Dolby Vision', 'HDR10+', 'HDR10',
  'HLG', 'Dolby Atmos', 'DD+', 'DTS-HD', 'TrueHD', 'MKV', 'MP4', 'MOV', 'TS',
  'ISO', 'BDMV', 'PGS', 'VOBSUB', 'SRT', 'ASS / SSA', 'OpenSubtitles',
];
---

<section class="section features-section" id="features">
  <div class="container">
    <!-- ── Section head ─────────────────────────────────────────── -->
    <header class="features-head reveal">
      <p class="eyebrow">Features</p>
      <h2 class="section-title">Plays anything.<br />Does everything.</h2>
      <p class="section-subtitle">
        A serious player at its core, wrapped in dozens of thoughtful touches
        that make Pippin yours.
      </p>
    </header>

    <!-- ── One unified grid of feature tiles ────────────────────── -->
    <ul class="features-grid" role="list">
      {features.map((f, i) => (
        <li
          class="feature-card glass reveal"
          style={`--reveal-delay:${Math.min(i * 45, 480)}ms`}
        >
          <span class="feature-icon" aria-hidden="true">
            {f.icon === 'film' && (
              <svg viewBox="0 0 24 24"><path d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm0 2v3h3V5H4Zm5 0v3h6V5H9Zm8 0v3h3V5h-3ZM4 10v4h3v-4H4Zm5 0v9h6v-9H9Zm8 0v4h3v-4h-3ZM4 16v3h3v-3H4Zm13 0v3h3v-3h-3Z" fill="currentColor"/></svg>
            )}
            {f.icon === 'hdr' && (
              <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2v16a8 8 0 0 1 0-16Z" fill="currentColor"/></svg>
            )}
            {f.icon === 'audio' && (
              <svg viewBox="0 0 24 24"><path d="M4 9h3l4-4v14l-4-4H4V9Zm11-1a1 1 0 0 1 1.7-.71 5 5 0 0 1 0 7.42A1 1 0 1 1 15 13.3a3 3 0 0 0 0-2.6A1 1 0 0 1 15 8Zm2.8-2.8a1 1 0 0 1 1.42 0 9 9 0 0 1 0 13.6 1 1 0 0 1-1.42-1.42 7 7 0 0 0 0-10.76 1 1 0 0 1 0-1.42Z" fill="currentColor"/></svg>
            )}
            {f.icon === 'subtitles' && (
              <svg viewBox="0 0 24 24"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 8h6v2H6v-2Zm8 0h4v2h-4v-2ZM6 8h4v2H6V8Zm6 0h6v2h-6V8Z" fill="currentColor"/></svg>
            )}
            {f.icon === 'subsfetch' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z"/><path d="M7.5 15.5h4M14 15.5h2.5" stroke-linecap="round"/></svg>
            )}
            {f.icon === 'previews' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m10 9.5 4 2.5-4 2.5z" fill="currentColor" stroke="none"/></svg>
            )}
            {f.icon === 'precision' && (
              <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 4v6l4 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {f.icon === 'resume' && (
              <svg viewBox="0 0 24 24"><path d="M12 4a8 8 0 1 1-7.6 5.5 1 1 0 0 1 1.9.66A6 6 0 1 0 12 6v2l-3.5-3L12 1v3Z" fill="currentColor"/></svg>
            )}
            {f.icon === 'offline' && (
              <svg viewBox="0 0 24 24"><path d="M12 3a1 1 0 0 1 1 1v9.6l2.3-2.3a1 1 0 0 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.4L11 13.6V4a1 1 0 0 1 1-1ZM5 19h14a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z" fill="currentColor"/></svg>
            )}
            {f.icon === 'layout' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2.5" />
                <path d="M3 9h18M9 9v12" />
              </svg>
            )}
            {f.icon === 'shelves' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="4.5" height="16" rx="1" />
                <rect x="9.75" y="4" width="4.5" height="16" rx="1" />
                <rect x="16.5" y="4" width="4.5" height="16" rx="1" />
              </svg>
            )}
            {f.icon === 'palette' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a9 9 0 1 0 0 18c1.4 0 2-.9 2-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.6 1.7-1.6H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7Z" />
                <circle cx="7.5" cy="10.5" r="1" fill="currentColor" stroke="none" />
                <circle cx="12" cy="7.5" r="1" fill="currentColor" stroke="none" />
                <circle cx="16.5" cy="10.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            )}
            {f.icon === 'poster' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="3" width="16" height="18" rx="2" />
                <path d="m8 15 2.5-3 2 2.2L15 11l3 4" />
                <circle cx="9" cy="8" r="1.4" />
              </svg>
            )}
            {f.icon === 'music' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V6l11-2v11" />
                <circle cx="6" cy="18" r="3" />
                <circle cx="17" cy="15" r="3" />
              </svg>
            )}
            {f.icon === 'servers' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="7" rx="2" />
                <rect x="3" y="13" width="18" height="7" rx="2" />
                <path d="M7 7.5h.01M7 16.5h.01" />
              </svg>
            )}
            {f.icon === 'ratings' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8L6.7 19.6l1-5.8L3.5 9.7l5.9-.9L12 3.5Z" />
              </svg>
            )}
            {f.icon === 'spoilers' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3l18 18" />
                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                <path d="M9.5 5.2A9.4 9.4 0 0 1 12 5c5 0 9 4.6 9 7 0 1-.7 2.3-1.9 3.4M6 6.1C3.8 7.5 3 9.7 3 12c0 0 4 7 9 7a9 9 0 0 0 3.4-.7" />
              </svg>
            )}
            {f.icon === 'search' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="6.5" />
                <path d="m20 20-3.6-3.6" />
              </svg>
            )}
          </span>
          <div class="feature-body">
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        </li>
      ))}
    </ul>

    <!-- ── Format wall (auto-scroll marquee) ────────────────────── -->
    <div class="format-wall reveal" style="--reveal-delay:120ms" aria-hidden="true">
      <div class="format-track">
        {formatChips.map((c) => <span class="format-chip">{c}</span>)}
        {formatChips.map((c) => <span class="format-chip">{c}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    overflow: clip;
  }

  /* ── Section head ──────────────────────────────────────────── */
  .features-head {
    max-width: 44rem;
    margin: 0 auto var(--space-8);
    text-align: center;
  }
  .features-head .section-title,
  .features-head .section-subtitle {
    margin-inline: auto;
  }

  /* ── One unified tile grid ─────────────────────────────────── */
  .features-grid {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    transition:
      transform var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
    will-change: transform;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-muted, var(--accent));
    box-shadow: var(--shadow-glow);
  }

  .feature-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-card);
    color: var(--accent);
    background: var(--accent-subtle);
    box-shadow: inset 0 0 0 1px var(--glass-border, var(--hairline));
    transition:
      background-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .feature-card:hover .feature-icon {
    transform: scale(1.06);
  }
  .feature-icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .feature-body {
    min-width: 0;
  }
  .feature-title {
    font-family: var(--font-display, var(--font-body));
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.25;
    margin: 0 0 var(--space-2);
    color: var(--label);
    letter-spacing: -0.01em;
  }
  .feature-desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    color: var(--label-secondary);
    text-wrap: pretty;
  }

  .features-more {
    margin: 0 auto var(--space-9);
    text-align: center;
    font-family: var(--font-display, var(--font-body));
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--label-tertiary);
    letter-spacing: -0.01em;
  }

  /* ── Format wall ───────────────────────────────────────────── */
  .format-wall {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }
  .format-track {
    display: flex;
    width: max-content;
    gap: var(--space-3);
    animation: format-marquee 42s linear infinite;
  }
  .format-wall:hover .format-track {
    animation-play-state: paused;
  }
  .format-chip {
    flex: none;
    padding: 0.45em 1em;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--label);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .format-chip:nth-child(3n) {
    background: var(--accent-subtle);
    border-color: var(--accent-muted);
    color: var(--accent);
  }
  @keyframes format-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .format-caption {
    margin-top: var(--space-4);
    text-align: center;
    font-size: 0.9rem;
    color: var(--label-tertiary);
    max-width: 44rem;
    margin-inline: auto;
  }

  /* ── Reduced motion ────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .format-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
      gap: var(--space-2);
    }
    .feature-card,
    .feature-icon {
      transition: none;
    }
    .feature-card:hover {
      transform: none;
    }
    .feature-card:hover .feature-icon {
      transform: none;
    }
  }
</style>
