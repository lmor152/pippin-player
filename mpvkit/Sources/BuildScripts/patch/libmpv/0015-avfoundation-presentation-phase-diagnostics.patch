+static int compare_phase_sample(const void *a, const void *b)
+{
+    int64_t x = *(const int64_t *)a;
+    int64_t y = *(const int64_t *)b;
+    return x < y ? -1 : (x > y ? 1 : 0);
+}
+
+// Summarises the presentation-phase samples collected since the last window.
+// Sorts the reservoir in place -- it is about to be reset anyway -- and runs
+// once per window, never per frame.
+static void report_presentation_phase(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    // An anchor zeroes the phase, so nothing measured before it can be
+    // differenced against anything measured after it. Invalidate first, and
+    // unconditionally: a window that anchored on every frame reports no
+    // samples at all, and must still not leave stale history behind for the
+    // next window to walk against.
+    if (p->diag_phase_anchor_count)
+        p->diag_phase_prev_valid = false;
+
+    if (!p->diag_phase_count)
+        return;
+
+    int n = p->diag_phase_sample_count;
+    double mean_ms = p->diag_phase_total_ns / 1e6 / p->diag_phase_count;
+    qsort(p->diag_phase_samples_ns, n, sizeof(p->diag_phase_samples_ns[0]),
+          compare_phase_sample);
+    // Even counts average the two middle samples, in floating point so the
+    // addition cannot overflow the integer nanosecond range.
+    double median_ms = (n % 2)
+        ? p->diag_phase_samples_ns[n / 2] / 1e6
+        : (p->diag_phase_samples_ns[n / 2 - 1] / 1e6 +
+           p->diag_phase_samples_ns[n / 2] / 1e6) / 2.0;
+
+    // The mean sits at the samples' time centroid, so that -- not a window
+    // edge -- is what successive means must be differenced against.
+    int64_t centroid_ns = p->diag_phase_first_ns +
+        p->diag_phase_time_total_ns / p->diag_phase_count;
+    bool clean = p->diag_phase_anchor_count == 0;
+
+    char walk[32] = "n/a";
+    if (clean && p->diag_phase_prev_valid) {
+        int64_t dt_ns = centroid_ns - p->diag_phase_prev_centroid_ns;
+        if (dt_ns > 0) {
+            snprintf(walk, sizeof(walk), "%+.3f ms/s",
+                     (mean_ms - p->diag_phase_prev_mean_ns / 1e6) /
+                         (dt_ns / 1e9));
+        }
+    }
+
+    MP_VERBOSE(vo, "Presentation phase over %.2fs: n=%d (%d smp), "
+               "mean %.2f ms, median %.2f ms, min %.2f ms, max %.2f ms, "
+               "walk %s, min pre-enqueue lead %.2f ms, %d already late "
+               "before enqueue, %d anchors\n",
+               (p->diag_phase_last_ns - p->diag_phase_first_ns) / 1e9,
+               p->diag_phase_count, n, mean_ms, median_ms,
+               p->diag_phase_min_ns / 1e6, p->diag_phase_max_ns / 1e6,
+               walk, p->diag_preenq_lead_min_ns / 1e6,
+               p->diag_preenq_late_count, p->diag_phase_anchor_count);
+
+    // Only an anchor-free window becomes history: an anchor zeroes the phase,
+    // so carrying that mean forward would make the NEXT window's walk read a
+    // sawtooth reset as drift.
+    p->diag_phase_prev_valid = clean;
+    if (clean) {
+        p->diag_phase_prev_mean_ns = (int64_t)(mean_ms * 1e6);
+        p->diag_phase_prev_centroid_ns = centroid_ns;
+    }
+}
+
 // Presentation-pacing telemetry, emitted about every 5s under -v. Kept
 // permanently: ready-waits (pacing back-pressure), deadline drops and the
 // timebase anchor rate are the primary signals for diagnosing judder.
@@ -943,11 +1148,14 @@ static void report_presentation_diagnostics(struct vo *vo)
                    p->diag_drop_count, p->diag_anchor_count);
     }
 
+    report_presentation_phase(vo);
+
     p->diag_window_start_ns = now;
     p->diag_wait_count = 0;
     p->diag_wait_total_ns = 0;
     p->diag_drop_count = 0;
     p->diag_anchor_count = 0;
+    reset_presentation_phase_window(p);
 }
 
