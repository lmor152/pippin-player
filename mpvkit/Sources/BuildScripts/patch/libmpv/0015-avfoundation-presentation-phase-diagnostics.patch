+static void reset_presentation_phase_window(struct priv *p)
+{
+    p->diag_phase_count = 0;
+    p->diag_phase_total_ns = 0;
+    p->diag_phase_min_ns = 0;
+    p->diag_phase_max_ns = 0;
+    p->diag_phase_anchor_count = 0;
+    p->diag_phase_first_ns = 0;
+    p->diag_phase_last_ns = 0;
+    p->diag_phase_time_total_ns = 0;
+    p->diag_phase_sample_count = 0;
+    p->diag_preenq_lead_min_ns = 0;
+    p->diag_preenq_late_count = 0;
+}
+
+// xorshift64*, used only to choose which samples the reservoir keeps. Local to
+// the VO so it needs no libc global state and no locking; "uniform enough" is
+// the entire requirement.
+static uint64_t diag_phase_random(struct priv *p)
+{
+    uint64_t x = p->diag_phase_rng;
+    x ^= x >> 12;
+    x ^= x << 25;
+    x ^= x >> 27;
+    p->diag_phase_rng = x;
+    return x * 0x2545F4914F6CDD1DULL;
+}
+
+// Accumulates one frame's intended-vs-actual presentation phase. Deliberately
+// aggregate-only: at 24-60fps a per-frame log line would swamp the log and
+// perturb the very timing it is measuring, so nothing is emitted here.
+static void record_presentation_phase(struct priv *p, int64_t now,
+                                      int64_t offset_ns, int64_t lead_ns)
+{
+    if (!p->diag_phase_count) {
+        p->diag_phase_min_ns = offset_ns;
+        p->diag_phase_max_ns = offset_ns;
+        p->diag_preenq_lead_min_ns = lead_ns;
+        p->diag_phase_first_ns = now;
+        if (!p->diag_phase_rng)
+            p->diag_phase_rng = (uint64_t)now | 1;
+    } else {
+        p->diag_phase_min_ns = MPMIN(p->diag_phase_min_ns, offset_ns);
+        p->diag_phase_max_ns = MPMAX(p->diag_phase_max_ns, offset_ns);
+        p->diag_preenq_lead_min_ns = MPMIN(p->diag_preenq_lead_min_ns, lead_ns);
+    }
+    p->diag_phase_last_ns = now;
+    p->diag_phase_time_total_ns += now - p->diag_phase_first_ns;
+    p->diag_phase_total_ns += offset_ns;
+    p->diag_phase_count++;
+    if (lead_ns < 0)
+        p->diag_preenq_late_count++;
+
+    if (p->diag_phase_sample_count < AVF_PHASE_SAMPLE_CAP) {
+        p->diag_phase_samples_ns[p->diag_phase_sample_count++] = offset_ns;
+    } else {
+        // Reservoir sampling (Algorithm R). diag_phase_count is already the
+        // 1-based index of this sample, so keeping it with probability
+        // CAP/count leaves every sample in the window equally likely to be
+        // retained -- necessary because a first-N buffer would describe only
+        // the start of the window, which is exactly wrong for a signal that
+        // walks.
+        uint64_t j = diag_phase_random(p) % (uint64_t)p->diag_phase_count;
+        if (j < (uint64_t)AVF_PHASE_SAMPLE_CAP)
+            p->diag_phase_samples_ns[j] = offset_ns;
+    }
+}
+
