+// The timebase rate must be mpv's actual --speed. Inferring it from a single
+// frame pair (media pts delta / host time delta) wobbles with scheduling
+// jitter and framedrops; each wobble past the change threshold re-anchors the
+// timebase at a wrong rate, which shows up as judder that worsens the further
+// playback speed is from 1x. Falls back to inference only if the option read
+// is unavailable.
+static double target_timebase_rate(struct vo *vo, int64_t media_pts_ns,
+                                   int64_t present_host_ns)
+{
+    struct priv *p = vo->priv;
+
+    if (p->root_opts_cache) {
+        m_config_cache_update(p->root_opts_cache);
+        struct MPOpts *root_opts = p->root_opts_cache->opts;
+        double speed = root_opts->playback_speed;
+        if (speed >= 0.01 && speed <= 100.0)
+            return speed;
+    }
+
+    return infer_timebase_rate(p, media_pts_ns, present_host_ns);
+}
+
 static void update_media_timebase_for_frame(struct vo *vo)
 {
