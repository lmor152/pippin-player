+// --- Multichannel LPCM output (0013, Pippin-original) ------------------------
+//
+// On Apple/AVFoundation only Dolby (AC-3/E-AC-3/MAT-Atmos) can be bitstreamed
+// by a third-party app; the compressed passthrough path above handles those.
+// Everything else that arrives as multichannel PCM -- DTS / DTS-HD MA / TrueHD /
+// multichannel FLAC / raw PCM, once mpv has decoded it -- has to be output as
+// correctly-laid-out LPCM here. Two things make that reliable:
+//
+//   1. A standard CoreAudio channel-layout TAG (not a bag of per-channel
+//      descriptions) so the HDMI/AVFoundation renderer knows exactly which
+//      physical speaker each interleaved channel drives.
+//   2. Negotiating the count against the current route: if the receiver can
+//      only take stereo, ask the core to downmix rather than shipping 5.1/7.1
+//      that the system would silently fold or drop.
+//
+// Channel-layout mapping (mpv speaker order -> CoreAudio tag / slot order).
+// mpv reorders its decoded output to match ao->channels, and the layout is
+// built from that same order, so data and layout stay consistent:
+//
+//   5.1  ao->channels := FL FR FC LFE  (BL|SL) (BR|SR)
+//        -> kAudioChannelLayoutTag_MPEG_5_1_A   [ L R C LFE Ls  Rs        ]
+//   7.1  ao->channels := FL FR FC LFE  SL SR  BL BR
+//        -> kAudioChannelLayoutTag_MPEG_7_1_C   [ L R C LFE Ls  Rs Rls Rrs ]
+//        mpv's SIDE pair -> the tag's primary surround (Ls/Rs); mpv's BACK
+//        pair -> the tag's rear surround (Rls/Rrs), which is the physical
+//        arrangement of a home-theatre 7.1 bed.
+//
+// Any other configuration (mono, stereo, 3.0/4.0, 6.1, exotic 8ch, height
+// beds) returns false and the caller keeps mpv's existing description-based
+// layout (ca_get_acl) untouched. Conservative by design: when unsure, do
+// exactly what the stock PCM path already did.
+
+static bool pcm_chmap_has(const struct mp_chmap *c, int speaker)
+{
+    for (int i = 0; i < c->num; i++) {
+        if (c->speaker[i] == speaker)
+            return true;
+    }
+    return false;
+}
+
+// Rewrite ao->channels into a canonical MPEG order for a recognized 5.1/7.1
+// bed and report the matching layout tag. Returns false (ao->channels left
+// unchanged) for anything not recognized.
+static bool pcm_canonical_multichannel(struct ao *ao, AudioChannelLayoutTag *tag_out)
+{
+    struct mp_chmap *ch = &ao->channels;
+
+    bool front = pcm_chmap_has(ch, MP_SPEAKER_ID_FL) &&
+                 pcm_chmap_has(ch, MP_SPEAKER_ID_FR) &&
+                 pcm_chmap_has(ch, MP_SPEAKER_ID_FC) &&
+                 pcm_chmap_has(ch, MP_SPEAKER_ID_LFE);
+    if (!front)
+        return false;
+
+    if (ch->num == 6) {
+        // Require a MATCHED surround pair -- both members from the same pair --
+        // so a mixed/asymmetric layout (e.g. BL + SR) is never silently retagged
+        // as standard 5.1. Either pair maps to the tag's Ls/Rs positions.
+        int sl, sr;
+        if (pcm_chmap_has(ch, MP_SPEAKER_ID_BL) &&
+            pcm_chmap_has(ch, MP_SPEAKER_ID_BR)) {
+            sl = MP_SPEAKER_ID_BL;  sr = MP_SPEAKER_ID_BR;
+        } else if (pcm_chmap_has(ch, MP_SPEAKER_ID_SL) &&
+                   pcm_chmap_has(ch, MP_SPEAKER_ID_SR)) {
+            sl = MP_SPEAKER_ID_SL;  sr = MP_SPEAKER_ID_SR;
+        } else {
+            return false;
+        }
+        struct mp_chmap n = { .num = 6 };
+        n.speaker[0] = MP_SPEAKER_ID_FL;  n.speaker[1] = MP_SPEAKER_ID_FR;
+        n.speaker[2] = MP_SPEAKER_ID_FC;  n.speaker[3] = MP_SPEAKER_ID_LFE;
+        n.speaker[4] = sl;                n.speaker[5] = sr;
+        *ch = n;
+        *tag_out = kAudioChannelLayoutTag_MPEG_5_1_A;
+        return true;
+    }
+
+    if (ch->num == 8 &&
+        pcm_chmap_has(ch, MP_SPEAKER_ID_SL) && pcm_chmap_has(ch, MP_SPEAKER_ID_SR) &&
+        pcm_chmap_has(ch, MP_SPEAKER_ID_BL) && pcm_chmap_has(ch, MP_SPEAKER_ID_BR)) {
+        struct mp_chmap n = { .num = 8 };
+        n.speaker[0] = MP_SPEAKER_ID_FL;  n.speaker[1] = MP_SPEAKER_ID_FR;
+        n.speaker[2] = MP_SPEAKER_ID_FC;  n.speaker[3] = MP_SPEAKER_ID_LFE;
+        n.speaker[4] = MP_SPEAKER_ID_SL;  n.speaker[5] = MP_SPEAKER_ID_SR;
+        n.speaker[6] = MP_SPEAKER_ID_BL;  n.speaker[7] = MP_SPEAKER_ID_BR;
+        *ch = n;
+        *tag_out = kAudioChannelLayoutTag_MPEG_7_1_C;
+        return true;
+    }
+
+    return false;
+}
+
+#if TARGET_OS_IPHONE
+// Does the current output route advertise a multichannel-capable layout?
+// Positive-evidence only (adapted from the compressed path's route reasoning):
+// supportedOutputChannelLayouts is populated for CarPlay/AirPlay routes and is
+// empty by design on HDMI, so a NON-EMPTY list that holds no >2ch entry is the
+// only signal treated as "stereo only". Empty or unavailable == unknown, and
+// unknown never blocks multichannel -- the renderer downmixes if it must.
+static bool pcm_route_supports_multichannel(struct ao *ao)
+{
+    if (@available(tvOS 17.2, iOS 17.2, *)) {
+        NSArray<AVAudioChannelLayout *> *layouts =
+            AVAudioSession.sharedInstance.supportedOutputChannelLayouts;
+        if (layouts.count > 0) {
+            for (AVAudioChannelLayout *layout in layouts) {
+                if (layout.channelCount > 2)
+                    return true;
+            }
+            MP_WARN(ao, "output route advertises only stereo layouts\n");
+            return false;
+        }
+    }
+    return true;
+}
+
+// Re-run the route capability decision and act only on a change that affects
+// us. Edge-triggered so a flapping capability cannot spin the AO: a reload
+// re-enters init(), which renegotiates the layout/downmix from scratch.
+static void pcm_reevaluate_capabilities(struct ao *ao, const char *reason)
+{
+    struct priv *p = ao->priv;
+    if (p->passthrough)
+        return;   // the compressed path owns its own recovery
+    bool supported = pcm_route_supports_multichannel(ao);
+    if (supported == p->pcm_route_multichannel)
+        return;
+    p->pcm_route_multichannel = supported;
+
+    // Reload only when the stereo/multichannel boundary crossing actually
+    // changes what we should be sending: we downmixed and width came back, or
+    // we are running wide and the route lost multichannel.
+    if ((p->pcm_downmixed && supported) ||
+        (!p->pcm_downmixed && !supported && ao->channels.num > 2)) {
+        MP_INFO(ao, "output route capability changed (%s); reloading audio to "
+                "renegotiate the channel layout\n", reason);
+        ao_request_reload(ao);
+    }
+}
+#endif
+
 // --- AC-3 / E-AC-3 compressed-audio passthrough ------------------------------
 //
 // mpv delivers compressed audio to an ao as IEC 61937 ("S/PDIF") data bursts:
@@ -505,6 +662,37 @@ - (void)handleRestartNotification:(NSNotification*)notification {
     stop(ao);
     start(ao);
 }
+#if TARGET_OS_IPHONE
+// Both handlers hop onto p->queue so the capability re-check is serialized
+// with feeding and cannot race a teardown; stop()/uninit() drain the queue.
+- (void)handleRouteChange:(NSNotification*)notification {
+    @synchronized(self) {
+        if (!ao)
+            return;
+        struct ao *_ao = ao;
+        struct priv *p = _ao->priv;
+        dispatch_async(p->queue, ^{
+            pcm_reevaluate_capabilities(_ao, "route change");
+        });
+    }
+}
+- (void)handleRenderingCapabilitiesChange:(NSNotification*)notification {
+    @synchronized(self) {
+        if (!ao)
+            return;
+        struct ao *_ao = ao;
+        struct priv *p = _ao->priv;
+        dispatch_async(p->queue, ^{
+            pcm_reevaluate_capabilities(_ao, "capabilities change");
+        });
+    }
+}
+#endif
+- (void)invalidate {
+    @synchronized(self) {
+        ao = NULL;
+    }
+}
 @end
 
