From: Pippin <noreply@pippin.app>
Date: Sat, 2 Aug 2026 00:00:00 +0000
Subject: [PATCH] videotoolbox: set compressed sample size explicitly

Ported from edde746/MPVKit (Plezy fork) for Pippin native Dolby Vision
VideoToolbox decode. Base: stock FFmpeg n8.0.1. License LGPLv2.1+.
---
diff --git a/libavcodec/videotoolbox.c b/libavcodec/videotoolbox.c
index a3e100f..c747ec4 100644
--- a/libavcodec/videotoolbox.c
+++ b/libavcodec/videotoolbox.c
@@ -686,9 +686,11 @@ static CMSampleBufferRef videotoolbox_sample_buffer_create(CMFormatDescriptionRe
     OSStatus status;
     CMBlockBufferRef  block_buf;
     CMSampleBufferRef sample_buf;
+    size_t sample_size;
 
     block_buf  = NULL;
     sample_buf = NULL;
+    sample_size = size;
 
     status = CMBlockBufferCreateWithMemoryBlock(kCFAllocatorDefault,// structureAllocator
                                                 buffer,             // memoryBlock
@@ -710,8 +712,8 @@ static CMSampleBufferRef videotoolbox_sample_buffer_create(CMFormatDescriptionRe
                                       1,                    // numSamples
                                       0,                    // numSampleTimingEntries
                                       NULL,                 // sampleTimingArray
-                                      0,                    // numSampleSizeEntries
-                                      NULL,                 // sampleSizeArray
+                                      1,                    // numSampleSizeEntries
+                                      &sample_size,         // sampleSizeArray
                                       &sample_buf);
     }
 
